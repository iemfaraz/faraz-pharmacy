FROM python:3.11-slim

WORKDIR /app

# OpenCV / Paddle runtime libs
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 libglib2.0-0 libgomp1 && rm -rf /var/lib/apt/lists/*

COPY requirements-api.txt .
RUN pip install --no-cache-dir -r requirements-api.txt

COPY config.py .
COPY app ./app

# Download the OCR models at build time so the first request is fast.
RUN python -c "from app.ocr.engine import OcrEngine; OcrEngine()"

ENV PORT=8000
EXPOSE 8000
HEALTHCHECK CMD python -c "import os,urllib.request; urllib.request.urlopen('http://localhost:'+os.environ.get('PORT','8000')+'/health')"

CMD ["sh", "-c", "uvicorn app.api.server:app --host 0.0.0.0 --port ${PORT} --workers 1"]
